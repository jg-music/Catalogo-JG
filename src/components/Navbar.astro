---
import { NAV_LINKS, SITE, waLink } from "@/lib/site";
import Button from "@/components/Button.astro";
import { Menu, X } from "@lucide/astro";
---

<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-40 transition-all duration-300"
>
  <nav class="container-site flex h-16 items-center justify-between md:h-20" aria-label="Navegación principal">
    <!-- Logo -->
    <a href="#inicio" class="flex items-center" aria-label={`${SITE.name} — Inicio`}>
      <img src="/images/logo.png" alt="JG Music Production" class="h-14 w-auto object-contain md:h-[72px]" width="1080" height="1080" />
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-7 lg:flex">
      {NAV_LINKS.map((l) => (
        <li>
          <a
            href={l.href}
            class="text-[13px] font-medium text-ivory/80 transition-colors duration-200 hover:text-gold"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      <Button href={waLink()} external class="hidden md:inline-flex">Cotizar Evento</Button>

      <!-- Mobile toggle -->
      <button
        id="nav-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg text-ivory lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <Menu id="icon-open" class="h-6 w-6" />
        <X id="icon-close" class="hidden h-6 w-6" />
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div
    id="nav-mobile"
    class="hidden border-t border-ivory/10 bg-noir/95 backdrop-blur-lg lg:hidden"
  >
    <ul class="container-site flex flex-col gap-1 py-4">
      {NAV_LINKS.map((l) => (
        <li>
          <a
            href={l.href}
            class="nav-mobile-link block rounded-lg px-3 py-3 text-sm font-medium text-ivory/85 transition-colors hover:bg-carbon hover:text-gold"
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="mt-2 px-3 pb-2">
        <Button href={waLink()} external class="w-full">Cotizar Evento</Button>
      </li>
    </ul>
  </div>
</header>

<script>
  const navbar = document.getElementById("navbar")!;
  const toggle = document.getElementById("nav-toggle")!;
  const mobile = document.getElementById("nav-mobile")!;
  const iconOpen = document.getElementById("icon-open")!;
  const iconClose = document.getElementById("icon-close")!;

  // Fondo sólido al hacer scroll
  const onScroll = () => {
    const scrolled = window.scrollY > 24;
    navbar.classList.toggle("bg-noir/90", scrolled);
    navbar.classList.toggle("backdrop-blur-lg", scrolled);
    navbar.classList.toggle("border-b", scrolled);
    navbar.classList.toggle("border-ivory/10", scrolled);
    navbar.classList.toggle("shadow-card", scrolled);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Menú móvil
  const setMenu = (open: boolean) => {
    mobile.classList.toggle("hidden", !open);
    iconOpen.classList.toggle("hidden", open);
    iconClose.classList.toggle("hidden", !open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };
  toggle.addEventListener("click", () =>
    setMenu(mobile.classList.contains("hidden"))
  );
  mobile.querySelectorAll(".nav-mobile-link").forEach((a) =>
    a.addEventListener("click", () => setMenu(false))
  );
</script>
