---
import { PACKAGES } from "@/lib/data";
import SectionHeading from "@/components/SectionHeading.astro";
import Button from "@/components/Button.astro";
import { waLink } from "@/lib/site";
import { Check } from "@lucide/astro";
---

<section id="paquetes" class="py-20 md:py-28" aria-label="Paquetes">
  <div class="container-site">
    <SectionHeading
      eyebrow="Paquetes"
      title="Un formato para cada ocasión"
      subtitle="Soluciones diseñadas según el tipo de evento, con producción completa y a la medida."
    />

    <div class="grid gap-7 lg:grid-cols-3">
      {PACKAGES.map((p, i) => (
        <article
          class="group relative flex flex-col overflow-hidden rounded-3xl border border-ivory/8 bg-carbon transition-all duration-300 hover:-translate-y-2 hover:border-gold/40 hover:shadow-gold"
          data-aos="fade-up"
          data-aos-delay={i * 120}
        >
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src={p.image}
              alt={`Paquete ${p.name}`}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon to-transparent" aria-hidden="true"></div>
            <h3 class="absolute bottom-4 left-6 font-display text-2xl font-extrabold uppercase tracking-wide">
              <span class="text-gold">/</span> {p.name}
            </h3>
          </div>

          <div class="flex flex-1 flex-col p-6 md:p-7">
            <p class="text-sm leading-relaxed text-muted">{p.description}</p>
            <ul class="mt-5 space-y-2.5">
              {p.items.map((item) => (
                <li class="flex items-center gap-2.5 text-sm text-ivory/85">
                  <Check class="h-4 w-4 shrink-0 text-gold" /> {item}
                </li>
              ))}
            </ul>
            <div class="mt-auto pt-7">
              <Button href={waLink(`Hola, quiero cotizar un paquete ${p.name} ✨`)} external class="w-full">
                Cotizar
              </Button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
