---

<footer id="contacto" class="border-t border-ivory/10 bg-carbon">
  <div class="container-site grid gap-10 py-14 md:grid-cols-3 md:py-20">
    <!-- Marca -->
    <div>
      <a href="#inicio" class="inline-flex" aria-label={`${SITE.name} — Inicio`}>
        <img src="/images/logo.png" alt="JG Music Production" class="h-24 w-auto object-contain" width="1080" height="1080" loading="lazy" />
      </a>
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-muted">
        {SITE.description}
      </p>
    </div>

    <!-- Navegación + contacto -->
    <div class="grid grid-cols-2 gap-8">
      <nav aria-label="Enlaces del sitio">
        <h3 class="mb-4 font-display text-xs font-bold uppercase tracking-[0.25em] text-gold">Sitio</h3>
        <ul class="space-y-2.5">
          {NAV_LINKS.map((l) => (
            <li><a href={l.href} class="text-sm text-ivory/70 transition-colors hover:text-gold">{l.label}</a></li>
          ))}
        </ul>
      </nav>
      <div>
        <h3 class="mb-4 font-display text-xs font-bold uppercase tracking-[0.25em] text-gold">Contacto</h3>
        <ul class="space-y-3 text-sm text-ivory/70">
          <li class="flex items-start gap-2">
            <Mail class="mt-0.5 h-4 w-4 shrink-0 text-gold" />
            <a href={`mailto:${SITE.email}`} class="break-all hover:text-gold">{SITE.email}</a>
          </li>
          <li class="flex items-start gap-2">
            <MapPin class="mt-0.5 h-4 w-4 shrink-0 text-gold" />
            {SITE.city}
          </li>
        </ul>
      </div>
    </div>

    <!-- Redes -->
    <div class="md:justify-self-end">
      <h3 class="mb-4 font-display text-xs font-bold uppercase tracking-[0.25em] text-gold">Síguenos</h3>
      <ul class="flex gap-3">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={s.label}
              class="flex h-11 w-11 items-center justify-center rounded-full border border-ivory/15 text-ivory/80 transition-all duration-300 hover:-translate-y-1 hover:border-gold hover:text-gold"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-ivory/10 py-5">
    <p class="container-site text-center text-xs text-muted">
      © {year} {SITE.name}. Todos los derechos reservados.
    </p>
  </div>
</footer>
